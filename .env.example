# Copy to .env and fill in what you have. Anything left empty simply stays off; `python -m diwan check` shows what is missing.

# Sign-in is on. off turns it off, only for tests and the browser checks in e2e/ on a scratch office.
DIWAN_AUTH=
# Meta Model API: Muse Spark, Voice Transcribe, Muse Image
META_API_KEY=

# Open-weight hosts for the compliance agents (Muse Spark Open). Any one is enough.
BASETEN_API_KEY=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
MODAL_ENDPOINT_URL=
MODAL_MODEL=
MODAL_API_KEY=

# Which open host to try first
DIWAN_OPEN_ORDER=baseten,fireworks,modal
# Allow compliance agents onto Meta's API when no open host is set up (development only)
DIWAN_OPEN_FALLBACK=
# off | replay | record
DIWAN_TAPE=replay
# 1 = never call a live model, replay tapes only
DIWAN_OFFLINE=

# WhatsApp Cloud API (Meta). Leave empty to use the sandbox phone on the Inbox screen.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# AiSensy (WhatsApp Business partner). Can also be entered on the Settings screen.
AISENSY_PROJECT_ID=
AISENSY_PROJECT_API_PWD=
AISENSY_API_KEY=
AISENSY_WEBHOOK_TOKEN=
# aisensy | cloud | sandbox (empty: whichever is connected)
WHATSAPP_PROVIDER=

# The owner's own number, which only Nova reads (see diwan/ownerline.py). Never the sales number.
# It only reads until PERSONAL_WHATSAPP_SENDING=on.
PERSONAL_WHATSAPP_TOKEN=
PERSONAL_WHATSAPP_PHONE_ID=
PERSONAL_WHATSAPP_VERIFY_TOKEN=
PERSONAL_WHATSAPP_APP_SECRET=
PERSONAL_WHATSAPP_SENDING=
PERSONAL_KEEP_DAYS=90

# Nova's own number, how she reaches the owner away from the app (see diwan/novaline.py). A third number.
NOVA_WHATSAPP_TOKEN=
NOVA_WHATSAPP_PHONE_ID=
NOVA_ALERT_TEMPLATE=
OWNER_WHATSAPP_NUMBER=

# Nova sends the owner's email from their own mailbox, only after their yes. Gmail: smtp.gmail.com and an app password.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Meta open weights (Muse Glimmer) on NVIDIA's free endpoint: development and fictional data only
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/muse-glimmer-30b

# Which model the Muse Spark agents use first. meta,nvidia (default) or nvidia,meta to keep development free.
# The free NVIDIA endpoint is often slower than the 25 seconds a live chat allows, so Rania and the Scribe fall back to rules.
DIWAN_SPARK_ORDER=
